import java.util.*;

class Solution {
    public List<List<Integer>> findDifference(
        int[] nums1, int[] nums2) {

        List<Integer> list1 = new ArrayList<>();
        List<Integer> list2 = new ArrayList<>();

        for (int num : nums1) {
            boolean found = false;

            for (int x : nums2) {
                if (num == x) {
                    found = true;
                    break;
                }
            }

            if (!found && !list1.contains(num)) {
                list1.add(num);
            }
        }

        for (int num : nums2) {
            boolean found = false;

            for (int x : nums1) {
                if (num == x) {
                    found = true;
                    break;
                }
            }

            if (!found && !list2.contains(num)) {
                list2.add(num);
            }
        }

        List<List<Integer>> result = new ArrayList<>();
        result.add(list1);
        result.add(list2);

        return result;
    }
}
